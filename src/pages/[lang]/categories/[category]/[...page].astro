---
import type { GetStaticPaths, Page } from "astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import PostCard from "../../../../components/PostCard.astro";
import Pagination from "../../../../components/Pagination.astro";
import { getCategories, type Post } from "../../../../lib/posts";
import { facetLangSwitch } from "../../../../lib/facet-routes";
import { POSTS_PER_PAGE } from "../../../../config/site";
import { absoluteUrl } from "../../../../lib/seo";
import { locales, useTranslations, localizedPath } from "../../../../i18n";

// One paginated listing per distinct category, per locale (REQ-019, REQ-037).
export const getStaticPaths = (async ({ paginate }) => {
  // Categories are authored per language, so collect every locale's set first and
  // tell the switcher which of them actually have this category.
  const byLocale = new Map<string, Map<string, Post[]>>();
  for (const lang of locales) byLocale.set(lang, await getCategories(lang));

  const paths = [];
  for (const lang of locales) {
    for (const [category, posts] of byLocale.get(lang)!) {
      const pageSize =
        POSTS_PER_PAGE > 0 ? POSTS_PER_PAGE : Math.max(posts.length, 1);
      const availableIn = locales.filter((l) => byLocale.get(l)!.has(category));
      paths.push(
        ...paginate(posts, { params: { lang, category }, pageSize, props: { availableIn } }),
      );
    }
  }
  return paths;
}) satisfies GetStaticPaths;

const { lang, category } = Astro.params;
const page = Astro.props.page as Page<Post>;
const availableIn = Astro.props.availableIn as string[];
const t = useTranslations(lang);
const path = page.url.current ?? localizedPath(lang, `/categories/${category}/`);

const breadcrumbs = [
  { name: t("nav.home"), url: absoluteUrl(localizedPath(lang, "/")) },
  { name: category, url: absoluteUrl(path) },
];
---

<BaseLayout
  title={category}
  description={`${t("category.for")} ${category}`}
  path={path}
  lang={lang}
  breadcrumbs={breadcrumbs}
  langSwitch={facetLangSwitch({
    kind: "categories",
    value: category!,
    locales,
    availableIn,
    fallbackPath: "/",
  })}
  prev={page.url.prev ? absoluteUrl(page.url.prev) : undefined}
  next={page.url.next ? absoluteUrl(page.url.next) : undefined}
>
  <h1>{category}</h1>
  {page.data.map((post) => <PostCard post={post} />)}
  <Pagination page={page} lang={lang} />
</BaseLayout>
