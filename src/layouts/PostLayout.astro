---
import { Image } from "astro:assets";
import BaseLayout from "./BaseLayout.astro";
import Comments from "../integrations/Comments.astro";
import ShareButtons from "../components/ShareButtons.astro";
import type { Post } from "../lib/posts";
import { formatDate, isoDate, absoluteUrl } from "../lib/seo";
import { useTranslations, localizedPath, localeMeta } from "../i18n";

interface Props {
  post: Post;
  /** Page/UI locale (drives all chrome). May differ from the post's content language. */
  uiLang: string;
  langSwitch: Record<string, string>;
  alternates: { hreflang: string; href: string }[];
  canonicalPath: string;
}
const { post, uiLang, langSwitch, alternates, canonicalPath } = Astro.props;
const { data } = post;

// Chrome follows the selected page locale (REQ-033); content keeps its own language.
const contentLang = data.lang;
const isFallback = uiLang !== contentLang;
const t = useTranslations(uiLang);

// Resolve the social image (REQ-012): explicit ogImage, else the cover, else a
// dynamically generated branded card at /og/<slug>.png (built by src/pages/og).
const ogSrc = data.ogImage ?? data.cover;
const image = ogSrc
  ? typeof ogSrc === "string"
    ? ogSrc
    : ogSrc.src
  : `/og/${post.slug}.png`;

const path = `/${uiLang}/posts/${post.slug}/`;
const canonicalURL = data.canonicalURL ?? absoluteUrl(canonicalPath);

// Breadcrumb trail (REQ-013): Home › [Category] › Post. Built in the content
// language so its URLs match the canonical (facet pages exist in that locale).
const tc = useTranslations(contentLang);
const breadcrumbs = [
  { name: tc("nav.home"), url: absoluteUrl(localizedPath(contentLang, "/")) },
  ...(data.category
    ? [{
        name: data.category,
        url: absoluteUrl(localizedPath(contentLang, `/categories/${data.category}/`)),
      }]
    : []),
  { name: data.title, url: canonicalURL },
];
---

<BaseLayout
  title={data.title}
  description={data.description}
  path={path}
  lang={uiLang}
  contentLang={contentLang}
  type="article"
  image={image}
  canonicalURL={canonicalURL}
  publishDate={data.publishDate}
  updatedDate={data.updatedDate}
  author={data.author}
  keywords={data.keywords}
  alternates={alternates}
  breadcrumbs={breadcrumbs}
  langSwitch={langSwitch}
>
  <!-- The article body keeps its own language for correct pronunciation/indexing.
       Only canonical (non-fallback) post pages are indexed for search (REQ-020):
       data-pagefind-body marks the post as the sole indexed content, so category,
       tag, month, home and about pages stay out of results; data-pagefind-meta
       carries the fields the search-result cards render. -->
  <article
    lang={isFallback ? localeMeta(contentLang).htmlLang : undefined}
    data-pagefind-body={!isFallback ? true : undefined}
  >
    <header class="post-header">
      <h1>{data.title}</h1>
      <p class="meta">
        <time datetime={isoDate(data.publishDate)} data-pagefind-meta="date">{formatDate(data.publishDate, uiLang)}</time>
        {data.updatedDate && <> · {t("post.updated")}{" "}{formatDate(data.updatedDate, uiLang)}</>}
        {data.category && (
          <> · <a href={localizedPath(contentLang, `/categories/${data.category}/`)} data-pagefind-meta="category">{data.category}</a></>
        )}
      </p>
    </header>

    {
      data.cover && (
        <Image
          class="cover"
          src={data.cover}
          alt={data.coverAlt ?? ""}
          widths={[480, 800, 1200]}
          loading="eager"
          data-pagefind-meta="image[src]"
        />
      )
    }

    <div class="prose">
      <slot />
    </div>

    {
      data.tags.length > 0 && (
        <ul class="tags" data-pagefind-meta={`tags:${data.tags.join(", ")}`}>
          {data.tags.map((tag) => (
            <li><a href={localizedPath(contentLang, `/tags/${tag}/`)}>#{tag}</a></li>
          ))}
        </ul>
      )
    }
  </article>

  <ShareButtons url={canonicalURL} title={data.title} lang={uiLang} />

  <Comments term={data.discussion} lang={uiLang} />

  {/* Click-to-zoom for images in the post body (.prose). Progressive
      enhancement: without JS the images stay inline and no cursor hint shows. */}
  <div
    id="post-lightbox"
    class="post-lightbox"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
    aria-label={t("a11y.imageClose")}
    data-zoom-label={t("a11y.imageZoom")}
  >
    <img alt="" />
  </div>
</BaseLayout>

<style>
  .post-header h1 {
    margin-bottom: 0.25rem;
  }
  .meta {
    color: var(--color-muted);
    font-size: 0.9rem;
    margin-top: 0;
  }
  .cover {
    width: 100%;
    height: auto;
    border-radius: 10px;
    margin: 1rem 0 2rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    font-size: 0.9rem;
  }
  .tags a {
    color: var(--color-muted);
  }
  .post-lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    background: rgba(0, 0, 0, 0.85);
    cursor: zoom-out;
  }
  .post-lightbox.open {
    display: flex;
  }
  .post-lightbox img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    border-radius: 8px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
  }
  @media (prefers-reduced-motion: no-preference) {
    .post-lightbox.open {
      animation: post-lightbox-fade 0.15s ease-out;
    }
    @keyframes post-lightbox-fade {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }
  }
</style>

<script>
  // Lightbox for post-body images only (.prose img). Cover and UI images are
  // untouched. The zoom cursor is set from JS so no-JS readers get no false
  // affordance.
  const box = document.getElementById("post-lightbox");
  const prose = document.querySelector(".prose");
  if (box && prose) {
    const boxImg = box.querySelector("img");
    const zoomLabel = (box as HTMLElement).dataset.zoomLabel ?? "";

    prose.querySelectorAll("img").forEach((img) => {
      img.style.cursor = "zoom-in";
      if (zoomLabel && !img.title) img.title = zoomLabel;
    });

    const open = (img: HTMLImageElement) => {
      boxImg!.src = img.currentSrc || img.src;
      boxImg!.alt = img.alt || "";
      box.classList.add("open");
      box.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    };
    const close = () => {
      box.classList.remove("open");
      box.setAttribute("aria-hidden", "true");
      boxImg!.removeAttribute("src");
      document.body.style.overflow = "";
    };

    prose.addEventListener("click", (e) => {
      const img = (e.target as HTMLElement).closest("img");
      if (img) open(img as HTMLImageElement);
    });
    box.addEventListener("click", close);
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && box.classList.contains("open")) close();
    });
  }
</script>
