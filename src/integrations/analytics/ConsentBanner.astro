---
// Cookie consent coordinator (REQ-042), provider-agnostic. Cookie-setting
// adapters (GA, AdSense, …) register a loader on `window.__consentLoaders`; this
// runs them only after the reader accepts — or immediately when consent is not
// required. `gated` (from the Analytics port) says whether any such provider is
// configured; when false, nothing renders, so the default build stays clean.
import { CONSENT } from "../../config/site";
import { useTranslations, localizedPath } from "../../i18n";

interface Props {
  lang: string;
  gated: boolean;
}
const { lang, gated } = Astro.props;
const t = useTranslations(lang);

// A site-relative policy path is resolved to the reader's locale — a bilingual
// site would otherwise link one language's policy from both banners. An absolute
// URL (a policy hosted elsewhere) is left untouched.
const privacyHref = CONSENT.privacyUrl.startsWith("/")
  ? localizedPath(lang, CONSENT.privacyUrl)
  : CONSENT.privacyUrl;

// Withdrawing consent has to be as easy as giving it (LGPD art. 8 §5, GDPR art. 7.3),
// so the decision is re-openable from the footer at any time. Rejecting after having
// accepted also expires the analytics cookies already set and reloads, since a script
// already running cannot be unloaded — otherwise "reject" would only apply next visit.
const consentScript = `(function(){
  function runAll(){ (window.__consentLoaders||[]).forEach(function(fn){ try{fn();}catch(e){} }); }
  function read(){ try{ return localStorage.getItem("consent"); }catch(e){ return null; } }
  function write(v){ try{ v===null?localStorage.removeItem("consent"):localStorage.setItem("consent",v); }catch(e){} }
  function dropCookies(){
    // A cookie is only erased by a delete that matches its own path and domain, so
    // try every ancestor path of the current URL, not just "/". (A cookie scoped to
    // a sibling path is not even readable from here, so it cannot be touched.)
    var host=location.hostname, paths=["/"], acc="";
    location.pathname.split("/").forEach(function(seg){
      if(!seg) return; acc+="/"+seg; paths.push(acc, acc+"/");
    });
    document.cookie.split(";").forEach(function(c){
      var name=c.split("=")[0].trim();
      if(name.indexOf("_ga")!==0 && name.indexOf("_gid")!==0) return;
      paths.forEach(function(p){
        var base=name+"=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path="+p;
        document.cookie=base;
        document.cookie=base+"; domain="+host;
        document.cookie=base+"; domain=."+host;
      });
    });
  }
  var required=${CONSENT.required ? "true" : "false"};
  var banner=document.getElementById("consent-banner");
  var reset=document.getElementById("consent-reset");
  var started=false;

  function decide(v){
    write(v);
    if(banner) banner.hidden=true;
    if(v==="granted"){ if(!started){ started=true; runAll(); } return; }
    // "started" — not the stored decision — is what says the tag is running in this
    // page: reopening the preferences clears the decision before you choose again.
    if(started){ dropCookies(); location.reload(); }
  }
  function open(){ if(banner){ banner.hidden=false; banner.scrollIntoView({block:"nearest"}); } }

  if(reset) reset.addEventListener("click", function(){ write(null); open(); });
  var a=document.getElementById("consent-accept"), r=document.getElementById("consent-reject");
  if(a) a.addEventListener("click", function(){ decide("granted"); });
  if(r) r.addEventListener("click", function(){ decide("denied"); });

  if(!required){ started=true; runAll(); return; }
  var decision=read();
  if(decision==="granted"){ started=true; runAll(); return; }
  if(decision==="denied") return;
  open();
})();`;
---

{
  gated && (
    <>
      {CONSENT.required && (
        <div id="consent-banner" class="consent" role="dialog" aria-label={t("consent.title")} hidden>
          <p class="consent-text">
            {t("consent.text")}
            {CONSENT.privacyUrl && (
              <>
                {" "}
                <a href={privacyHref}>{t("consent.privacy")}</a>
              </>
            )}
          </p>
          <div class="consent-actions">
            <button id="consent-reject" type="button" class="consent-btn">
              {t("consent.reject")}
            </button>
            <button id="consent-accept" type="button" class="consent-btn consent-accept">
              {t("consent.accept")}
            </button>
          </div>
        </div>
      )}
      <script is:inline set:html={consentScript} />
    </>
  )
}

<style>
  /* `display: flex` below outranks the browser's own [hidden] rule, so without
     this the banner stays on screen after a decision — hidden in the DOM, visible
     to the reader. */
  .consent[hidden] {
    display: none;
  }
  .consent {
    position: fixed;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    z-index: 50;
    max-width: 44rem;
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    padding: 1rem 1.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.3);
  }
  .consent-text {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-text);
    flex: 1 1 16rem;
  }
  .consent-actions {
    display: flex;
    gap: 0.5rem;
  }
  .consent-btn {
    font: inherit;
    font-size: 0.9rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
  }
  .consent-btn:hover {
    border-color: var(--color-accent);
  }
  .consent-accept {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-accent-contrast);
    font-weight: 600;
  }
</style>
